# PramLearn Frontend Environment Configuration

# Backend REST API URL (akhiri dengan slash /)
# Contoh lokal: http://localhost:8000/api/
# Contoh production (Render/Vercel): https://your-backend-app.onrender.com/api/
VITE_API_URL=http://localhost:8000/api/

# Backend WebSocket URL (akhiri dengan slash /)
# Contoh lokal: ws://localhost:8000/ws/
# Contoh production (Render/WSS): wss://your-backend-app.onrender.com/ws/
VITE_WS_URL=ws://localhost:8000/ws/

# Fallback URLs (Opsional jika ada secondary endpoint)
VITE_API_URL_FALLBACK=
VITE_WS_URL_FALLBACK=