# Database Configuration (Supabase PostgreSQL Connection String)
# Gunakan Connection String dari Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Format URI: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_SSL_REQUIRE=True

# Redis Configuration (Opsional untuk Channels / WebSocket)
REDIS_URL=redis://localhost:6379

# Django Settings
DEBUG=False
SECRET_KEY=your-strong-django-secret-key-change-this
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com
DJANGO_SETTINGS_MODULE=pramlearn_api.settings

# Azure Storage Settings (Opsional, jika upload file media ke Azure Blob)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER=media